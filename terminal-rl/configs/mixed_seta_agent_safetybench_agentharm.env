# Example terminal-rl three-source mixed training config.
# Usage:
#   set -a
#   source terminal-rl/configs/mixed_seta_agent_safetybench_agentharm.env
#   set +a
#   bash terminal-rl/terminal-rl_qwen3-8b_pu.sh

DATASET=mixed

# In agentharm-enabled mixed mode, only sources with a positive MIX_*_RATIO
# are included. This supports arbitrary subsets and ratios.
MIX_SETA_RATIO=6
MIX_SAFETY_RATIO=2
MIX_AGENTHARM_RATIO=2
MIX_SEED=42

# Optional. If unset, the mixer chooses the largest no-oversampling total.
# MIX_TOTAL=1200
# MIX_OVERSAMPLE=1

SETA_SAFETY=clawsentry
SAFETY_BENCH_REWARD=rule
AGENTHARM_REWARD=rule

AGENT_SAFETYBENCH_ROOT=/mnt/shared-storage-user/puyuan/code/Agent-SafetyBench
AGENTHARM_ROOT=/mnt/shared-storage-user/puyuan/code/inspect_evals/src/inspect_evals/agentharm
AGENT_SAFETYBENCH_REMOTE_ENV=0
AGENTHARM_REMOTE_ENV=0
