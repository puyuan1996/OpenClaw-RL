# Example terminal-rl mixed training config.
# Usage:
#   set -a
#   source terminal-rl/configs/mixed_seta_agent_safetybench.env
#   set +a
#   bash terminal-rl/terminal-rl_qwen3-8b_pu.sh

DATASET=mixed

# Keep mixed unset to preserve legacy full-concat behavior.
# Set ratios to build a deterministic subset at this proportion.
MIX_SETA_RATIO=7
MIX_SAFETY_RATIO=3
MIX_SEED=42

# Optional. If unset, the mixer chooses the largest no-oversampling total.
# MIX_TOTAL=1965
# MIX_OVERSAMPLE=1

SETA_SAFETY=clawsentry
SAFETY_BENCH_REWARD=rule
AGENT_SAFETYBENCH_ROOT=/mnt/shared-storage-user/puyuan/code/Agent-SafetyBench
